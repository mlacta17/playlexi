{
  "name": "@playlexi/app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "build:web": "expo export --platform web",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@playlexi/audio-contract": "workspace:*",
    "@playlexi/domain": "workspace:*",
    "@playlexi/speech-contract": "workspace:*",
    "@playlexi/test-fixtures": "workspace:*",
    "expo": "58.0.17",
    "expo-audio": "58.0.10",
    "expo-constants": "58.0.13",
    "expo-linking": "58.0.14",
    "expo-router": "58.0.25",
    "expo-splash-screen": "58.0.11",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/../../packages"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@react-navigation/.*|react-native-safe-area-context|react-native-screens))"
    ]
  }
}
